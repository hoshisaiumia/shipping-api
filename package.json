    "i18n-iso-countries": "^7.14.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "standard-version": "^9.5.0"
